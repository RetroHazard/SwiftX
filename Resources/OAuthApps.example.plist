<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SwiftX baked-in OAuth app credentials.

  These identify SwiftX ITSELF to each host (not the end user). Register an app
  with each provider once, then copy this file to `OAuthApps.plist` (same
  folder) and fill in the keys. `OAuthApps.plist` is git-ignored so real keys
  never enter the open-source tree; make-app.sh copies it into the bundle when
  present. End users then only click "Connect" and sign in — no key entry.

  Redirect URI to register with every host: http://127.0.0.1  (loopback)

  Client secrets: a desktop app can't keep a secret truly secret, so PKCE is the
  real protection. Public-client hosts need NO secret — leave ClientSecret empty:
    - OneDrive                -> PKCE only, ClientSecret blank
    - Google Drive, YouTube   -> desktop-client secret required (semi-public)

  Keys are the OAuthProviderID raw values: GoogleDrive, YouTube, OneDrive.
-->
<plist version="1.0">
<dict>
    <key>GoogleDrive</key>
    <dict>
        <key>ClientID</key>
        <string></string>
        <key>ClientSecret</key>
        <string></string>
    </dict>
    <key>YouTube</key>
    <dict>
        <key>ClientID</key>
        <string></string>
        <key>ClientSecret</key>
        <string></string>
    </dict>
    <key>OneDrive</key>
    <dict>
        <key>ClientID</key>
        <string></string>
        <key>ClientSecret</key>
        <string></string>
    </dict>
</dict>
</plist>
